<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- TCP server endpoint -->
    <add key="ServerHost" value="127.0.0.1" />
    <add key="ServerPort" value="5050" />

    <!-- Heartbeat settings -->
    <add key="HeartbeatEnabled" value="true" />
    <add key="HeartbeatIntervalSeconds" value="10" />

    <!-- Reconnect backoff -->
    <add key="ReconnectDelaySeconds" value="5" />
  </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>