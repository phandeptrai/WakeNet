<?xml version="1.0" encoding="utf-8" ?>
<!-- Chỉnh IP/port tại đây — được dùng chung bởi WakeNetServer và WakeNetClient. -->
<appSettings>
  <add key="ServerHost" value="10.255.223.199" />
  <add key="ServerPort" value="5050" />
  <!-- Client-only -->
  <add key="HeartbeatEnabled" value="true" />
  <add key="HeartbeatIntervalSeconds" value="10" />
  <add key="ReconnectDelaySeconds" value="5" />
</appSettings>
